     return InitStatus::OK;
   }
 
+  // A previous Terminate() leaves quit_ = true. The ADM instance can be
+  // re-Init'ed (the media engine terminates the device module when the last
+  // PeerConnection is released and re-initializes it when a new one is
+  // created). Without this reset the recording/playout threads spawned below
+  // see quit_ and exit on the first start request, so StartRecording/
+  // StartPlayout time out after 10 s and audio never resumes.
+  {
+    MutexLock lock(&mutex_);
+    quit_ = false;
+  }
+
